%% deployment-diagram.mmd — infra topology at hyperscale
%% Source for docs/deployment.md and docs/scaling.md.
%% Render with: mmdc -i deployment-diagram.mmd -o deployment-diagram.png

flowchart TB
    subgraph Region["Per-region deployment (repeated across N active-active regions)"]
        direction TB

        subgraph CPUTier["CPU node pool (~1,500 media servers region-wide)"]
            MS[Media Server Fleet]
            VADS[vad-service]
            DNS[denoiser]
            SCHED[scheduler]
            SESS[session-manager<br/>+ Aerospike<br/><small>Redis Cluster documented as fallback</small>]
            ANALYTICS[analytics]
            BILLING[billing]
        end

        subgraph GPUTier["GPU node pools (~39K GPUs region-wide, conservative)"]
            STT["stt-service<br/>~22K GPUs"]
            LLMGW["llm-gateway<br/>~5.5K GPUs<br/><small>intent + sentiment + model-tier routing</small>"]
            TTSS["tts-service<br/>~11K GPUs"]
            RAG["rag-service<br/>gap-closing"]
            TRITON["(shared GPU batching/routing layer:<br/>Triton or vLLM/TensorRT-LLM's own<br/>serving stack -- infra, not a service)"]
        end

        subgraph CoordTier["Coordinator tier"]
            ORCH["call-orchestrator<br/>~1 replica per concurrent call"]
            COMP["compliance<br/>stateless, no GPU<br/><small>+ tool calling to loan servicing backend/CRM</small>"]
        end

        NGINX[nginx edge / TLS termination]
        KAFKA[(Kafka event backbone)]

        NGINX --> ORCH
        ORCH --> VADS
        ORCH --> DNS
        ORCH --> STT
        ORCH --> LLMGW
        ORCH --> COMP
        COMP --> RAG
        ORCH --> TTSS
        ORCH --> SESS
        ORCH --> KAFKA
        STT -.-> TRITON
        LLMGW -.-> TRITON
        TTSS -.-> TRITON
        KAFKA --> ANALYTICS
        KAFKA --> BILLING
        SCHED --> ORCH
    end

    CARRIER[Multi-carrier SIP trunks] --> NGINX
    Region -.->|active-active failover| Region2[Other Region]
